{
  "name": "taskwitness",
  "version": "0.1.1",
  "description": "Evidence-backed completion reports for AI coding agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "taskwitness": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:test && node .test-dist/scripts/run-tests.js",
    "test:package": "npm run build:test && node .test-dist/scripts/package-smoke.js",
    "build:test": "tsc -p tsconfig.test.json",
    "demo": "npm run build && node demo/run-demo.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm run test:package"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "ai-agent",
    "verification",
    "git",
    "cli",
    "evidence",
    "ci",
    "code-review",
    "security",
    "developer-tools"
  ],
  "author": {
    "name": "digsarab112 and TaskWitness contributors",
    "url": "https://github.com/digsarab112"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digsarab112/taskwitness.git"
  },
  "bugs": {
    "url": "https://github.com/digsarab112/taskwitness/issues"
  },
  "homepage": "https://github.com/digsarab112/taskwitness#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "cross-spawn": "^7.0.6",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/cross-spawn": "^6.0.6",
    "eslint": "^10.8.1",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
